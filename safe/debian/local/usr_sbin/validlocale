#!/bin/sh
set -eu

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] || [ $# -lt 1 ]; then
    echo "Usage: $0 <locale>"
    exit 1
fi

locale_name=$1
normalized=$(printf '%s\n' "$locale_name" | sed \
    -e 's/\.UTF-8/.utf8/g' \
    -e 's/\.utf-8/.utf8/g' \
    -e 's/\.UTF8/.utf8/g')

case "$normalized" in
    C|POSIX|C.utf8)
        echo "locale '$locale_name' valid and available" >&2
        exit 0
        ;;
esac

if /usr/bin/locale -a 2>/dev/null | sed \
    -e 's/\.UTF-8/.utf8/g' \
    -e 's/\.utf-8/.utf8/g' \
    -e 's/\.UTF8/.utf8/g' | grep -Fx -- "$normalized" >/dev/null; then
    echo "locale '$locale_name' valid and available" >&2
    exit 0
fi

base=${locale_name%%.*}
base=${base%%@*}
modifier=
case "$locale_name" in
    *@*) modifier="@${locale_name#*@}" ;;
esac
charset=${locale_name#*.}
if [ "$charset" = "$locale_name" ] || [ -z "$charset" ]; then
    charset=UTF-8
else
    charset=${charset%%@*}
fi

if [ -r /usr/share/i18n/SUPPORTED ]; then
    supported=$(awk -v loc="$base$modifier" -v want="$locale_name" '
        $1 == want { print $1 " " $2; found = 1; exit }
        $1 == loc && $2 == "UTF-8" { print $1 " " $2; found = 1; exit }
        END { exit found ? 0 : 1 }
    ' /usr/share/i18n/SUPPORTED 2>/dev/null || true)
    if [ -n "$supported" ]; then
        echo "locale '$locale_name' not available" >&2
        printf '%s\n' "$supported"
        exit 1
    fi
fi

echo "locale '$locale_name' not available" >&2
printf '%s %s\n' "$base$modifier" "$charset"
exit 1
